# Copy this file to .env for local development and replace every placeholder.
# Never commit .env or put these values in VITE_* variables.

ADMIN_USERNAME=change_this_admin_username
ADMIN_PASSWORD=replace_with_a_long_unique_password
SESSION_SECRET=replace_with_at_least_32_random_characters

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=quiz_app
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_DATABASE=quiz_app
MYSQL_CONNECTION_LIMIT=10

# Local Express API port; hosting providers can set this automatically.
PORT=3001
